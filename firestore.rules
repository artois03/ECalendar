rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  match /users/{uid}/data/{docId} {
   function validCalendar() {return request.resource.data.keys().hasOnly(['version','events','missing','subjects','tasks']) && request.resource.data.version == 4 && request.resource.data.events is list && request.resource.data.missing is list && request.resource.data.subjects is list && request.resource.data.tasks is list && request.resource.data.events.size() <= 500 && request.resource.data.missing.size() <= 500 && request.resource.data.subjects.size() <= 200 && request.resource.data.tasks.size() <= 1000;}
   allow read: if owner(uid) && docId == 'calendar';
   allow create,update: if owner(uid) && docId == 'calendar' && validCalendar();
   allow delete: if false;
  }
  match /users/{uid}/settings/{docId} {
   allow read: if owner(uid) && docId == 'preferences';
   allow create,update: if owner(uid) && docId == 'preferences' && request.resource.data.keys().hasOnly(['theme','enabled','exams','tasks','days','time','timezone']) && request.resource.data.theme in ['system','light','dark'] && request.resource.data.enabled is bool && request.resource.data.exams is bool && request.resource.data.tasks is bool && request.resource.data.days is list && request.resource.data.days.size() <= 4 && request.resource.data.time is string && request.resource.data.time.size() == 5 && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && request.resource.data.timezone is string && request.resource.data.timezone.size() <= 70;
   allow delete: if false;
  }
  match /users/{uid}/devices/{deviceId} {
   allow read,delete: if owner(uid);
   allow create,update: if owner(uid) && deviceId.size() <= 80 && request.resource.data.keys().hasOnly(['endpoint','keys','platform','updatedAt']) && request.resource.data.endpoint is string && request.resource.data.endpoint.size() <= 2048 && request.resource.data.keys is map && request.resource.data.keys.keys().hasOnly(['auth','p256dh']) && request.resource.data.keys.auth is string && request.resource.data.keys.p256dh is string && request.resource.data.platform in ['iOS','Android','Desktop'] && request.resource.data.updatedAt is timestamp;
  }
  match /users/{uid}/notificationLog/{id} {allow read,write: if false;}
 }
}
