rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Само собственикът на профила може да прочита или променя своя календар.
    match /users/{userId}/data/{docId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId
                  && docId == 'calendar';
      allow create, update: if request.auth != null
                  && request.auth.uid == userId
                  && docId == 'calendar'
                  && request.resource.data.keys().hasOnly(['version','events','missing'])
                  && request.resource.data.version == 3
                  && request.resource.data.events is list
                  && request.resource.data.missing is list
                  && request.resource.data.events.size() <= 500
                  && request.resource.data.missing.size() <= 500;
      allow delete: if false;
    }
  }
}
